# ==============================================================================
# RenewalTrack — Backend Environment Variables Configuration Template
# Copy this file to .env and configure your secrets.
# NEVER commit your .env file with real credentials to GitHub or public repos.
# ==============================================================================

# Server Configuration
PORT=3000
APP_URL=http://localhost:3000
OPEN_BROWSER=0

# Supabase PostgreSQL Database Configuration
# Find these in your Supabase project settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Authentication Secret
JWT_SECRET=renewaltrack_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Real Email Delivery Configuration
# ------------------------------------------------------------------------------
# Choose your active provider: "nodemailer" (for Gmail SMTP) or "resend" (for Resend API)
EMAIL_PROVIDER=resend

# Master Delivery Switch:
# true  = Send REAL emails directly to inboxes using the configured provider.
# false = Disable email delivery.
EMAIL_SEND_ENABLED=true

# Sender Display Name and Address
FROM_NAME=RenewalTrack Alerts
# For Gmail SMTP, leave empty or set to your Gmail address.
# For Resend, set to your verified domain email (e.g. RenewalTrack <notifications@your-verified-domain.com> or RenewalTrack <onboarding@resend.dev>).
EMAIL_FROM=RenewalTrack <notifications@your-verified-domain.com>
FROM_EMAIL=

# ------------------------------------------------------------------------------
# Option 1: Gmail SMTP Configuration (Recommended for quick, zero-cost setup)
# ------------------------------------------------------------------------------
# How to get a Gmail App Password:
# 1. Go to your Google Account (https://myaccount.google.com/)
# 2. Select "Security" on the left panel.
# 3. Ensure "2-Step Verification" is turned ON.
# 4. Search for "App Passwords" in the top search bar (or go to: https://myaccount.google.com/apppasswords).
# 5. Name your app "RenewalTrack" and click "Create".
# 6. Copy the generated 16-character password (e.g., "abcd efgh ijkl mnop").
# 7. Paste it below as SMTP_PASS without spaces (e.g., "abcdefghijklmnop").
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_SERVICE=gmail
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password

# ------------------------------------------------------------------------------
# Option 2: Resend API Configuration (Modern transactional email API)
# ------------------------------------------------------------------------------
# How to get a Resend API Key:
# 1. Sign up for a free account at https://resend.com
# 2. Navigate to "API Keys" (https://resend.com/api-keys)
# 3. Click "Create API Key", name it "RenewalTrack", and select "Full access".
# 4. Copy the API key (starts with "re_...") and paste it below.
# 5. For testing without a custom domain, emails are sent from "RenewalTrack <onboarding@resend.dev>"
#    (Note: In Resend sandbox mode, emails can only be delivered to your registered Resend account email).
# 6. To send to any recipient, verify your domain under "Domains" (https://resend.com/domains).
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=RenewalTrack <notifications@your-verified-domain.com>

# ------------------------------------------------------------------------------
# Automated Reminder Cron Schedule (Standard 5-part cron expression)
# Default: "0 8 * * *" (Runs everyday at 08:00 AM)
# For testing every minute: "* * * * *"
# ------------------------------------------------------------------------------
CRON_SCHEDULE=0 8 * * *

# Fallback email address for notifications if renewal has no assigned recipient
ALERT_FALLBACK_EMAIL=elakkiya270806@gmail.com

