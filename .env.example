# ==============================================================================
# RenewGuard — Backend Environment Variables Configuration Template
# Copy this file to .env and configure your secrets.
# NEVER commit your .env file with real credentials to GitHub.
# ==============================================================================

# Server Configuration
PORT=3000
APP_URL=http://localhost:3000
OPEN_BROWSER=0

# Supabase PostgreSQL Database Configuration
# Find these in your Supabase project settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Authentication Secret
JWT_SECRET=renewguard_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Email Delivery Provider: "nodemailer" or "resend"
EMAIL_PROVIDER=nodemailer

# Safety Switch: Set to true to send REAL emails to actual inboxes.
# If false (default), emails are simulated and logged safely to the console.
EMAIL_SEND_ENABLED=false

# ------------------------------------------------------------------------------
# Nodemailer SMTP Configuration (Used when EMAIL_PROVIDER=nodemailer)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
FROM_EMAIL=reminders@renewguard.com
FROM_NAME=RenewGuard Alerts

# ------------------------------------------------------------------------------
# Resend API Configuration (Used when EMAIL_PROVIDER=resend)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_1234567890abcdefghijklmnopqrstuvwxyz

# ------------------------------------------------------------------------------
# Automated Reminder Cron Schedule (Standard 5-part cron expression)
# Default: "0 8 * * *" (Runs everyday at 08:00 AM)
# For testing every minute: "* * * * *"
# ------------------------------------------------------------------------------
CRON_SCHEDULE=0 8 * * *

# Fallback email address for renewals without an assigned user email
ALERT_FALLBACK_EMAIL=demo@renewaltrack.com
