# ==============================================================================
# RenewalTrack — Production Environment Configuration Template
# For Render (Node.js Backend) and Vercel (Frontend)
#
# NEVER commit your real .env file with secrets to GitHub or public repositories.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Host Configuration
# ------------------------------------------------------------------------------
# Render assigns PORT automatically (e.g., 10000). Leave as 3000 locally.
PORT=3000

# BACKEND_URL: The public URL of your Render backend.
# Production: https://renewaltrack-tyvw.onrender.com
# Local: http://localhost:3000
BACKEND_URL=https://renewaltrack-tyvw.onrender.com

# APP_URL: The public URL of your FRONTEND (e.g. deployed on Vercel).
# This is used in invitation emails and password reset links.
# Local: http://localhost:3000
# Production (Vercel): https://renewal-track.vercel.app
APP_URL=https://renewal-track.vercel.app

# ALLOWED_ORIGINS: Comma-separated list of origins allowed by CORS.
# Local: http://localhost:3000
# Production: https://renewal-track.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=https://renewal-track.vercel.app,http://localhost:3000

# Allow automatic Vercel preview deployment URLs (*.vercel.app)
ALLOW_VERCEL_PREVIEWS=true

# OPEN_BROWSER: 1 to auto-open browser on local startup (0 in production)
OPEN_BROWSER=0

# ------------------------------------------------------------------------------
# 2. Data Persistence Configuration (Crucial for Render Restarts)
# ------------------------------------------------------------------------------
# Option A: Render Persistent Disk (Recommended if not using Supabase)
# Render web services reset files on restart unless a disk is attached.
# When a Render Disk is mounted at /var/data, set DATA_DIR=/var/data.
# The server will automatically initialize store.json from data/seed.json on first run.
DATA_DIR=/var/data

# Option B: Supabase Cloud PostgreSQL (Free Tier Alternative)
# If set, RenewalTrack automatically uses Supabase PostgreSQL instead of local files.
# Data is permanently saved in PostgreSQL across all server restarts.
# Find these in your Supabase dashboard -> Project Settings -> API:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 3. JWT Authentication Security
# ------------------------------------------------------------------------------
# Cryptographic secret for signing session tokens.
# Use a strong 32+ character random string in production.
JWT_SECRET=renewaltrack_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 4. Email Delivery Configuration (Gmail SMTP or Resend API)
# ------------------------------------------------------------------------------
# Active provider: "nodemailer" (for Gmail SMTP) or "resend" (for Resend API)
EMAIL_PROVIDER=nodemailer

# Master Delivery Switch (true = real email delivery, false = simulation mode)
EMAIL_SEND_ENABLED=true

# Sender Display Name and Address
FROM_NAME=RenewalTrack Alerts
FROM_EMAIL=elakkiya270806@gmail.com
EMAIL_FROM=RenewalTrack <elakkiya270806@gmail.com>

# ------------------------------------------------------------------------------
# 5. Gmail SMTP Credentials (Zero Cost, High Deliverability)
# ------------------------------------------------------------------------------
# How to generate a Gmail App Password:
# 1. Open Google Account (https://myaccount.google.com/)
# 2. Select "Security" -> Turn ON "2-Step Verification" (if not already enabled)
# 3. Visit https://myaccount.google.com/apppasswords
# 4. Enter app name "RenewalTrack" and click "Create"
# 5. Copy the 16-character code (e.g. "abcd efgh ijkl mnop")
# 6. Paste it below as GMAIL_APP_PASSWORD without spaces (e.g. "abcdefghijklmnop")
# ------------------------------------------------------------------------------
GMAIL_USER=elakkiya270806@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_SERVICE=gmail
SMTP_USER=elakkiya270806@gmail.com
SMTP_PASS=your-16-character-app-password

# ------------------------------------------------------------------------------
# 6. Resend API Credentials (Alternative Transactional Email)
# ------------------------------------------------------------------------------
# Only needed if EMAIL_PROVIDER is set to "resend"
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM=RenewalTrack <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 7. Background Cron Scheduler & Fallback
# ------------------------------------------------------------------------------
# Daily reminder dispatch schedule (default: 08:00 AM daily -> '0 8 * * *')
CRON_SCHEDULE=0 8 * * *

# Fallback email address for alerts if a renewal has no assigned recipient
ALERT_FALLBACK_EMAIL=elakkiya270806@gmail.com
